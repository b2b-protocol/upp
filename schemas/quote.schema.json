{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://b2bprotocol.com/schemas/quote.schema.json",
  "title": "UPP Quote",
  "type": "object",
  "required": ["specVersion", "id", "type", "rfqId", "vendor", "lineItems", "validUntil", "currency"],
  "properties": {
    "specVersion": { "type": "string" },
    "schemaVersion": { "type": "string" },
    "id": { "type": "string" },
    "type": { "const": "Quote" },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" },
    "rfqId": { "type": "string" },
    "vendor": { "$ref": "#/$defs/party" },
    "currency": { "type": "string" },
    "validUntil": { "type": "string", "format": "date-time" },
    "paymentTerms": { "$ref": "#/$defs/paymentTerms" },
    "lineItems": {
      "type": "array",
      "items": { "$ref": "#/$defs/quotedLineItem" },
      "minItems": 1
    },
    "totals": {
      "type": "object",
      "properties": {
        "subtotal": { "type": "number", "minimum": 0 },
        "tax": { "type": "number", "minimum": 0 },
        "total": { "type": "number", "minimum": 0 }
      },
      "required": ["total"],
      "additionalProperties": false
    },
    "extensions": { "$ref": "#/$defs/extensions" }
  },
  "$defs": {
    "party": {
      "type": "object",
      "required": ["id", "name"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" }
      },
      "additionalProperties": true
    },
    "quotedLineItem": {
      "type": "object",
      "required": ["rfqLineItemId", "quantity", "unitPrice"],
      "properties": {
        "rfqLineItemId": { "type": "string" },
        "quantity": { "type": "number", "exclusiveMinimum": 0 },
        "unitPrice": { "type": "number", "minimum": 0 },
        "leadTimeDays": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": true
    },
    "paymentTerms": {
      "type": "object",
      "properties": {
        "code": { "type": "string" },
        "dueDays": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": true
    },
    "extensions": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z0-9]+(\\.[a-z0-9-]+)+$"
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
