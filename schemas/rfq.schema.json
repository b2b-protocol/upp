{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://b2bprotocol.com/schemas/rfq.schema.json",
  "title": "UPP RFQ",
  "type": "object",
  "required": ["specVersion", "id", "type", "buyer", "vendor", "lineItems", "responseDueAt"],
  "properties": {
    "specVersion": { "type": "string" },
    "schemaVersion": { "type": "string" },
    "id": {
      "type": "string",
      "upp_request": {
        "create": "omit",
        "update": "required"
      },
      "upp_response": "required"
    },
    "type": {
      "const": "RFQ",
      "upp_request": "required",
      "upp_response": "required"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "upp_request": "omit",
      "upp_response": "required"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time",
      "upp_request": "omit",
      "upp_response": "required"
    },
    "intentId": {
      "type": "string",
      "upp_request": "optional",
      "upp_response": "optional"
    },
    "discoveryResponseId": {
      "type": "string",
      "upp_request": "optional",
      "upp_response": "optional"
    },
    "buyer": { "$ref": "#/$defs/party" },
    "vendor": { "$ref": "#/$defs/party" },
    "currency": {
      "type": "string",
      "upp_request": "optional",
      "upp_response": "optional"
    },
    "responseDueAt": {
      "type": "string",
      "format": "date-time",
      "upp_request": "required",
      "upp_response": "required"
    },
    "deliveryLocation": {
      "type": "object",
      "properties": {
        "country": { "type": "string" },
        "city": { "type": "string" }
      },
      "required": ["country"],
      "additionalProperties": true
    },
    "paymentTerms": {
      "$ref": "#/$defs/paymentTerms",
      "upp_request": "optional",
      "upp_response": "optional"
    },
    "lineItems": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/lineItem" },
      "upp_request": "required",
      "upp_response": "required"
    },
    "extensions": {
      "$ref": "#/$defs/extensions",
      "upp_request": "optional",
      "upp_response": "optional"
    }
  },
  "$defs": {
    "party": {
      "type": "object",
      "required": ["id", "name"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" }
      },
      "additionalProperties": true
    },
    "lineItem": {
      "type": "object",
      "required": ["id", "description", "quantity", "unit"],
      "properties": {
        "id": { "type": "string" },
        "description": { "type": "string" },
        "quantity": { "type": "number", "exclusiveMinimum": 0 },
        "unit": { "type": "string" },
        "targetUnitPrice": { "type": "number", "minimum": 0 }
      },
      "additionalProperties": true
    },
    "paymentTerms": {
      "type": "object",
      "properties": {
        "code": { "type": "string" },
        "dueDays": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": true
    },
    "extensions": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z0-9]+(\\.[a-z0-9-]+)+$"
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
