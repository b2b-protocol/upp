{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://b2bprotocol.com/schemas/intent.schema.json",
  "title": "UPP Intent",
  "type": "object",
  "required": ["specVersion", "id", "type", "buyer", "title", "deliverables"],
  "properties": {
    "specVersion": { "type": "string" },
    "schemaVersion": { "type": "string" },
    "id": {
      "type": "string",
      "upp_request": {
        "create": "omit",
        "update": "required"
      },
      "upp_response": "required"
    },
    "type": {
      "const": "Intent",
      "upp_request": "required",
      "upp_response": "required"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "upp_request": "omit",
      "upp_response": "required"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time",
      "upp_request": "omit",
      "upp_response": "required"
    },
    "buyer": { "$ref": "#/$defs/party" },
    "sourceArtifactIds": {
      "type": "array",
      "items": { "type": "string" },
      "upp_request": {
        "create": "optional",
        "update": "optional"
      },
      "upp_response": "required"
    },
    "title": {
      "type": "string",
      "upp_request": "required",
      "upp_response": "required"
    },
    "summary": {
      "type": "string",
      "upp_request": "optional",
      "upp_response": "optional"
    },
    "category": {
      "type": "string",
      "upp_request": "optional",
      "upp_response": "optional"
    },
    "deliveryLocation": {
      "type": "string",
      "upp_request": "optional",
      "upp_response": "optional"
    },
    "budgetAmount": {
      "type": "number",
      "upp_request": "optional",
      "upp_response": "optional"
    },
    "budgetCurrency": {
      "type": "string",
      "upp_request": "optional",
      "upp_response": "optional"
    },
    "responseDueAt": {
      "type": "string",
      "format": "date-time",
      "upp_request": "optional",
      "upp_response": "optional"
    },
    "deliverables": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/deliverable" },
      "upp_request": "required",
      "upp_response": "required"
    },
    "constraints": {
      "type": "array",
      "items": { "$ref": "#/$defs/constraint" },
      "upp_request": "optional",
      "upp_response": "optional"
    },
    "paymentTerms": {
      "$ref": "#/$defs/paymentTerms",
      "upp_request": "optional",
      "upp_response": "optional"
    },
    "extensions": {
      "$ref": "#/$defs/extensions",
      "upp_request": "optional",
      "upp_response": "optional"
    }
  },
  "$defs": {
    "party": {
      "type": "object",
      "required": ["id", "name"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "contactEmail": { "type": "string", "format": "email" },
        "externalIds": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        }
      },
      "additionalProperties": false
    },
    "deliverable": {
      "type": "object",
      "required": ["id", "description"],
      "properties": {
        "id": { "type": "string" },
        "description": { "type": "string" },
        "quantity": { "type": "number", "exclusiveMinimum": 0 },
        "unit": { "type": "string" },
        "targetDate": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": false
    },
    "constraint": {
      "type": "object",
      "required": ["kind", "operator", "value", "strength"],
      "properties": {
        "kind": { "type": "string" },
        "operator": {
          "enum": ["equals", "in", "gte", "lte", "contains"]
        },
        "value": true,
        "strength": {
          "enum": ["required", "preferred"]
        },
        "rationale": { "type": "string" }
      },
      "additionalProperties": false
    },
    "paymentTerms": {
      "type": "object",
      "properties": {
        "code": { "type": "string" },
        "dueDays": { "type": "integer", "minimum": 0 },
        "discountPercent": { "type": "number", "minimum": 0 }
      },
      "additionalProperties": true
    },
    "extensions": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z0-9]+(\\.[a-z0-9-]+)+$"
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
