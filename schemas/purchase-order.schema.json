{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://b2bprotocol.com/schemas/purchase-order.schema.json",
  "title": "UPP Purchase Order",
  "type": "object",
  "required": ["specVersion", "id", "type", "buyer", "vendor", "lineItems", "status", "currency"],
  "properties": {
    "specVersion": { "type": "string" },
    "schemaVersion": { "type": "string" },
    "id": {
      "type": "string",
      "upp_request": {
        "create": "omit",
        "update": "required"
      },
      "upp_response": "required"
    },
    "type": {
      "const": "PurchaseOrder",
      "upp_request": "required",
      "upp_response": "required"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "upp_request": "omit",
      "upp_response": "required"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time",
      "upp_request": "omit",
      "upp_response": "required"
    },
    "buyer": { "$ref": "#/$defs/party" },
    "vendor": { "$ref": "#/$defs/party" },
    "intentId": {
      "type": "string",
      "upp_request": "optional",
      "upp_response": "optional"
    },
    "rfqId": {
      "type": "string",
      "upp_request": "optional",
      "upp_response": "optional"
    },
    "quoteId": {
      "type": "string",
      "upp_request": "optional",
      "upp_response": "optional"
    },
    "status": {
      "enum": ["draft", "submitted", "accepted", "rejected", "partially_fulfilled", "fulfilled", "cancelled"],
      "upp_request": "optional",
      "upp_response": "required"
    },
    "bindingState": {
      "$ref": "#/$defs/bindingState",
      "upp_request": "optional",
      "upp_response": "optional"
    },
    "currency": {
      "type": "string",
      "upp_request": "required",
      "upp_response": "required"
    },
    "paymentTerms": {
      "$ref": "#/$defs/paymentTerms",
      "upp_request": "optional",
      "upp_response": "optional"
    },
    "approvalStatus": {
      "$ref": "#/$defs/approvalStatus",
      "upp_request": "optional",
      "upp_response": "optional"
    },
    "lineItems": {
      "type": "array",
      "items": { "$ref": "#/$defs/poLineItem" },
      "minItems": 1,
      "upp_request": "required",
      "upp_response": "required"
    },
    "totals": {
      "type": "object",
      "properties": {
        "subtotal": { "type": "number", "minimum": 0 },
        "tax": { "type": "number", "minimum": 0 },
        "total": { "type": "number", "minimum": 0 }
      },
      "required": ["total"],
      "additionalProperties": false,
      "upp_request": "optional",
      "upp_response": "optional"
    },
    "extensions": {
      "$ref": "#/$defs/extensions",
      "upp_request": "optional",
      "upp_response": "optional"
    }
  },
  "$defs": {
    "party": {
      "type": "object",
      "required": ["id", "name"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" }
      },
      "additionalProperties": true
    },
    "paymentTerms": {
      "type": "object",
      "properties": {
        "code": { "type": "string" },
        "dueDays": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": true
    },
    "approvalStatus": {
      "type": "object",
      "properties": {
        "state": { "enum": ["not_required", "pending", "approved", "rejected"] },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["state"],
      "additionalProperties": true
    },
    "bindingState": {
      "type": "object",
      "required": ["state", "binding"],
      "properties": {
        "state": {
          "enum": [
            "exploratory",
            "indicative",
            "quoted",
            "approved",
            "committed"
          ]
        },
        "binding": {
          "enum": ["non_binding", "binding"]
        },
        "notes": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "poLineItem": {
      "type": "object",
      "required": ["id", "description", "quantity", "unit", "unitPrice"],
      "properties": {
        "id": { "type": "string" },
        "description": { "type": "string" },
        "quantity": { "type": "number", "exclusiveMinimum": 0 },
        "unit": { "type": "string" },
        "unitPrice": { "type": "number", "minimum": 0 }
      },
      "additionalProperties": true
    },
    "extensions": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z0-9]+(\\.[a-z0-9-]+)+$"
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
