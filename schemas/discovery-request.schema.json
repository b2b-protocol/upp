{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://b2bprotocol.com/schemas/discovery-request.schema.json",
  "title": "UPP Discovery Request",
  "type": "object",
  "required": ["specVersion", "id", "type", "intentId"],
  "properties": {
    "specVersion": { "type": "string" },
    "schemaVersion": { "type": "string" },
    "id": { "type": "string" },
    "type": { "const": "DiscoveryRequest" },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" },
    "intentId": { "type": "string" },
    "buyer": { "$ref": "#/$defs/party" },
    "supplierFilters": {
      "type": "object",
      "additionalProperties": true
    },
    "requestedModules": {
      "type": "array",
      "items": { "type": "string" }
    },
    "constraints": {
      "type": "array",
      "items": { "$ref": "#/$defs/constraint" }
    },
    "extensions": { "$ref": "#/$defs/extensions" }
  },
  "$defs": {
    "party": {
      "type": "object",
      "required": ["id", "name"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "contactEmail": { "type": "string", "format": "email" },
        "externalIds": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        }
      },
      "additionalProperties": false
    },
    "constraint": {
      "type": "object",
      "required": ["kind", "operator", "value", "strength"],
      "properties": {
        "kind": { "type": "string" },
        "operator": {
          "enum": ["equals", "in", "gte", "lte", "contains"]
        },
        "value": true,
        "strength": {
          "enum": ["required", "preferred"]
        },
        "rationale": { "type": "string" }
      },
      "additionalProperties": false
    },
    "extensions": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z0-9]+(\\.[a-z0-9-]+)+$"
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
