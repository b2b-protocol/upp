{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://b2bprotocol.com/schemas/invoice.schema.json",
  "title": "UPP Invoice",
  "type": "object",
  "required": ["specVersion", "id", "type", "invoiceNumber", "buyer", "vendor", "currency", "lineItems", "matchStatus"],
  "properties": {
    "specVersion": { "type": "string" },
    "schemaVersion": { "type": "string" },
    "id": {
      "type": "string",
      "upp_request": {
        "create": "omit",
        "update": "required"
      },
      "upp_response": "required"
    },
    "type": {
      "const": "Invoice",
      "upp_request": "required",
      "upp_response": "required"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "upp_request": "omit",
      "upp_response": "required"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time",
      "upp_request": "omit",
      "upp_response": "required"
    },
    "invoiceNumber": {
      "type": "string",
      "upp_request": "required",
      "upp_response": "required"
    },
    "buyer": { "$ref": "#/$defs/party" },
    "vendor": { "$ref": "#/$defs/party" },
    "purchaseOrderId": {
      "type": "string",
      "upp_request": "optional",
      "upp_response": "optional"
    },
    "quoteId": {
      "type": "string",
      "upp_request": "optional",
      "upp_response": "optional"
    },
    "currency": {
      "type": "string",
      "upp_request": "required",
      "upp_response": "required"
    },
    "issuedAt": {
      "type": "string",
      "format": "date-time",
      "upp_request": "optional",
      "upp_response": "optional"
    },
    "dueAt": {
      "type": "string",
      "format": "date-time",
      "upp_request": "optional",
      "upp_response": "optional"
    },
    "paymentTerms": {
      "$ref": "#/$defs/paymentTerms",
      "upp_request": "optional",
      "upp_response": "optional"
    },
    "matchStatus": {
      "enum": ["matched", "mismatch", "pending_review"],
      "upp_request": "optional",
      "upp_response": "required"
    },
    "lineItems": {
      "type": "array",
      "items": { "$ref": "#/$defs/invoiceLineItem" },
      "minItems": 1,
      "upp_request": "required",
      "upp_response": "required"
    },
    "totals": {
      "type": "object",
      "properties": {
        "subtotal": { "type": "number", "minimum": 0 },
        "tax": { "type": "number", "minimum": 0 },
        "total": { "type": "number", "minimum": 0 }
      },
      "required": ["total"],
      "additionalProperties": false,
      "upp_request": "optional",
      "upp_response": "optional"
    },
    "extensions": {
      "$ref": "#/$defs/extensions",
      "upp_request": "optional",
      "upp_response": "optional"
    }
  },
  "$defs": {
    "party": {
      "type": "object",
      "required": ["id", "name"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" }
      },
      "additionalProperties": true
    },
    "paymentTerms": {
      "type": "object",
      "properties": {
        "code": { "type": "string" },
        "dueDays": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": true
    },
    "invoiceLineItem": {
      "type": "object",
      "required": ["id", "description", "quantity", "unitPrice"],
      "properties": {
        "id": { "type": "string" },
        "description": { "type": "string" },
        "quantity": { "type": "number", "exclusiveMinimum": 0 },
        "unitPrice": { "type": "number", "minimum": 0 }
      },
      "additionalProperties": true
    },
    "extensions": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z0-9]+(\\.[a-z0-9-]+)+$"
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
