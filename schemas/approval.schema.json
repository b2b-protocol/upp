{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://b2bprotocol.com/schemas/approval.schema.json",
  "title": "UPP Approval Status",
  "type": "object",
  "required": ["specVersion", "id", "type", "resourceType", "resourceId", "state"],
  "properties": {
    "specVersion": { "type": "string" },
    "schemaVersion": { "type": "string" },
    "id": {
      "type": "string",
      "upp_request": {
        "create": "omit",
        "update": "required"
      },
      "upp_response": "required"
    },
    "type": {
      "const": "ApprovalStatus",
      "upp_request": "required",
      "upp_response": "required"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "upp_request": "omit",
      "upp_response": "required"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time",
      "upp_request": "optional",
      "upp_response": "required"
    },
    "resourceType": {
      "enum": ["RFQ", "Quote", "PurchaseOrder", "Invoice"],
      "upp_request": "required",
      "upp_response": "required"
    },
    "resourceId": {
      "type": "string",
      "upp_request": "required",
      "upp_response": "required"
    },
    "state": {
      "enum": ["not_required", "pending", "approved", "rejected"],
      "upp_request": "optional",
      "upp_response": "required"
    },
    "approver": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" }
      },
      "additionalProperties": true
    },
    "reason": { "type": "string" },
    "extensions": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z0-9]+(\\.[a-z0-9-]+)+$"
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
